{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "functions": {
    "api/*.js": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/book-consultation",
      "destination": "/book.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/sat",
      "destination": "/sat-diagnostic.html"
    },
    {
      "source": "/consulting",
      "destination": "/consulting.html"
    },
    {
      "source": "/seminar",
      "destination": "/seminar.html"
    },
    {
      "source": "/shsat",
      "destination": "/shsat-diagnostic.html"
    },
    {
      "source": "/thank-you",
      "destination": "/thank-you.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    }
  ]
}