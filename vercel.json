{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "functions": {
    "api/*.js": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/book-consultation",
      "destination": "/book.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/sat",
      "destination": "/sat-diagnostic.html"
    },
    {
      "source": "/consulting",
      "destination": "/consulting.html"
    },
    {
      "source": "/seminar",
      "destination": "/seminar.html"
    },
    {
      "source": "/seminar-cn",
      "destination": "/seminar.html"
    },
    {
      "source": "/shsat",
      "destination": "/shsat-diagnostic.html"
    },
    {
      "source": "/shsat/quiz",
      "destination": "/shsat-quiz.html"
    },
    {
      "source": "/shsat/quiz/",
      "destination": "/shsat-quiz.html"
    },
    {
      "source": "/thank-you",
      "destination": "/thank-you.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    }
  ],
  "headers": [
    {
      "source": "/oauth/(.*)",
      "headers": [
        {"key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src https://redwtpcrugsftaaezhky.supabase.co; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"},
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Robots-Tag", "value": "noindex, nofollow"},
        {"key": "Cache-Control", "value": "no-store"}
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/shsat/quiz",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/shsat/quiz/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/shsat-quiz.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
